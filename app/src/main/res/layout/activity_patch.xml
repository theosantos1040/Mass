<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_header"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt; "
            android:textColor="@color/accent_green"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="ANALISE DO APP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvScanResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="Escaneando..." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="12dp" />

            <TextView
                android:text="OPCOES DE PATCH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbIAP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bypass de compras in-app (IAP)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:buttonTint="@color/accent_green"
                android:checked="true"
                android:paddingStart="8dp"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cbAds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remocao de anuncios"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:buttonTint="@color/accent_green"
                android:checked="true"
                android:paddingStart="8dp"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cbLicense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bypass de verificacao de licenca"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:buttonTint="@color/accent_green"
                android:checked="true"
                android:paddingStart="8dp"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cbProtection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bypass de protecoes anti-patcher"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:buttonTint="@color/accent_green"
                android:checked="true"
                android:paddingStart="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="12dp" />

            <TextView
                android:text="LOG DO PATCH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp" />

            <ScrollView
                android:id="@+id/scrollLog"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/bg_card">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="@color/log_text"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:text="" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:progressTint="@color/accent_green"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPatch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="APLICAR PATCH"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="@color/accent_green" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnInstall"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="INSTALAR"
                android:textColor="@color/accent_green"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="@color/bg_card"
                android:visibility="gone" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btnUninstall"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="DESINSTALAR"
                android:textColor="#FF4444"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="@color/bg_card"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
