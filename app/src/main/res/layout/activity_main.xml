<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_header"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="THEO PATCHER"
                android:textColor="@color/accent_green"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.1 Mini Pro Era"
                android:textColor="@color/accent_green"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:background="@color/bg_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carregando..."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPickApk"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="SELECIONAR APK DO ARMAZENAMENTO"
        android:textColor="#000000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_green" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OU ESCOLHA UM APP INSTALADO"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:paddingVertical="8dp" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_card"
        android:hint="Buscar apps..."
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:paddingHorizontal="16dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="200dp"
            android:layout_height="8dp"
            android:indeterminate="true"
            android:progressTint="@color/accent_green"
            android:progressBackgroundTint="@color/bg_card" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Carregando apps..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAppList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp"
        android:visibility="gone" />

</LinearLayout>
